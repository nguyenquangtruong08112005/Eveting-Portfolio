# Eventing web environment template
# NEXT_PUBLIC_* values are bundled into the browser; never put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3301
NEXT_PUBLIC_GRAFANA_DASHBOARD_PATH=/d/eventing-overview/eventing-overview

NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Social Login Client IDs (Public only; never expose client secrets to the browser)
# Google OAuth 2.0 Client ID
# Prerequisites in Google Cloud Console:
# 1. Add Authorized JavaScript origins: http://localhost:3001 (or production web domain)
# 2. Enable Google People / OAuth 2.0 APIs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook App ID
# Prerequisites in Meta for Developers Console:
# 1. Add App Domains: localhost (or production web domain)
# 2. Add Valid OAuth Redirect URIs / Allowed Domains under Facebook Login settings
NEXT_PUBLIC_FACEBOOK_APP_ID=
