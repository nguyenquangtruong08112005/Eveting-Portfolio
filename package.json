{
  "name": "eventing-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Eventing monorepo — master local dev scripts (Windows)",
  "scripts": {
    "infra:up": "npm.cmd --prefix server run local:infra",
    "infra:down": "npm.cmd --prefix server run local:down",
    "db:migrate": "npm.cmd --prefix server run db:migrate",
    "db:seed": "npm.cmd --prefix server run db:seed:platform",
    "db:seed:clean": "npm.cmd --prefix server run db:clean:demo",
    "db:seed:reindex": "npm.cmd --prefix server run db:seed:reindex",
    "db:verify:seed": "npm.cmd --prefix server run db:verify:seed",
    "dev:api": "npm.cmd --prefix server run dev",
    "dev:web": "npm.cmd --prefix web run dev -- -p 3001",
    "dev:up": "cmd /c scripts\\dev-up.cmd",
    "dev:up:no-ngrok": "cmd /c scripts\\dev-up-pure.cmd --no-ngrok",
    "dev:down": "cmd /c scripts\\dev-down.cmd",
    "docker:build": "docker compose -f docker-compose.yml -f docker-compose.app.yml build",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.app.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.app.yml down",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.app.yml logs -f",
    "obs:up": "cmd /c scripts\\obs-up.cmd",
    "obs:down": "cmd /c scripts\\obs-down.cmd",
    "obs:logs": "docker compose -f server/infra/docker/docker-compose.observability.yml logs -f --tail=100"
  }
}
