[app_servers]
# Replace with the EC2 instance ID output by Terraform (terraform output -raw instance_id)
# ansible_connection=amazon.aws.aws_ssm uses AWS SSM Session Manager — no SSH key needed.
i-1234567890abcdef0 ansible_connection=amazon.aws.aws_ssm ansible_user=ubuntu

[all:vars]
ansible_python_interpreter=/usr/bin/python3
environment=staging
project_root=/opt/server-eventing
