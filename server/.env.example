# Eventing API environment template
# Copy to .env for local development. Keep real provider keys out of Git.

NODE_ENV=development
PORT=3000

# Local Docker infra from server/infra/docker/docker-compose.local.yml
DATABASE_URL=postgres://eventing:eventing_dev_password@localhost:55432/eventing_dev
REDIS_URL=redis://localhost:6379
ELASTIC_NODE_URL=http://localhost:9200

# Provider switches
AUTH_PROVIDER=backend
DATABASE_PROVIDER=postgres
STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=onesignal
ONESIGNAL_TARGET_MODE=external_id

# Auth and tickets
ACCESS_TOKEN_SECRET=replace-with-local-access-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-local-refresh-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_TICKET_SECRET=replace-with-local-ticket-secret-at-least-32-chars
QR_CODE_TTL=300
ADMIN_UID=admin

# OAuth/social login
GOOGLE_ALLOWED_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AUTH_SOCIAL_DEV_BYPASS=false

# Transactional Email (Resend SMTP or generic SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM="Eventing <noreply@moteo.fun>"
AUTH_MOCK_EMAIL=true

# Payment - ZaloPay sandbox/local placeholders
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
PAYMENT_WEBHOOK_SECRET=replace-with-local-payment-webhook-secret
APP_PUBLIC_URL=http://localhost:3000

# Weather
OPENWEATHER_API_KEY=

# Storage - S3 compatible (Cloudflare R2, AWS S3, MinIO)
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL_BASE=

# Push - OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Logging / observability
LOG_LEVEL=info
LOG_CONSOLE=true

